# Provider environment for dsh-identity. Copy to /etc/dsh-public/identity-secrets/identity.env (root:root 0600) and fill in on the host.
# Never commit real values. Unknown providers or missing variables refuse startup.
# See packages/identity/README.md "Providers" for every variable and the official API references.

# Mail: sendmail | smtp
DSH_MAIL_PROVIDER=smtp
DSH_MAIL_FROM=noreply@mail.harness.example.com
# Alibaba Cloud DirectMail: smtpdm.aliyun.com 465 tls (or 80/25 starttls). User = sender address, password = SMTP password set in the console.
# Tencent Cloud SES: smtp.qcloudmail.com 465 tls (or 25 starttls); gz-smtp.qcloudmail.com for Guangzhou.
DSH_SMTP_HOST=smtpdm.aliyun.com
DSH_SMTP_PORT=465
DSH_SMTP_SECURITY=tls
DSH_SMTP_USER=noreply@mail.harness.example.com
DSH_SMTP_PASSWORD=
# DSH_SENDMAIL_COMMAND=/usr/sbin/sendmail   (with DSH_MAIL_PROVIDER=sendmail)

# Human verification: aliyun | tencent | turnstile | none (invite-only)
DSH_CAPTCHA_PROVIDER=aliyun
DSH_ALIYUN_CAPTCHA_ACCESS_KEY_ID=
DSH_ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
DSH_ALIYUN_CAPTCHA_SCENE_ID=
DSH_ALIYUN_CAPTCHA_PREFIX=
# DSH_ALIYUN_CAPTCHA_REGION=cn
# DSH_TENCENT_CAPTCHA_SECRET_ID=  DSH_TENCENT_CAPTCHA_SECRET_KEY=  DSH_TENCENT_CAPTCHA_APP_ID=  DSH_TENCENT_CAPTCHA_APP_SECRET_KEY=
# DSH_TURNSTILE_SITE_KEY=  DSH_TURNSTILE_SECRET_KEY=
