# Provider environment for dsh-identity. Copy to /etc/dsh-public/identity-secrets/identity.env (root:root 0600) and fill in on the host.
# Never commit real values. Unknown providers or missing variables refuse startup.
# See packages/identity/README.md "Providers" for every variable and the official API references.

# Mail: sendmail | smtp
DSH_MAIL_PROVIDER=smtp
DSH_MAIL_FROM=noreply@mail.harness.example.com
# Alibaba Cloud DirectMail: smtpdm.aliyun.com 465 tls (or 80/25 starttls). User = sender address, password = SMTP password set in the console.
# Tencent Cloud SES: smtp.qcloudmail.com 465 tls (or 25 starttls); gz-smtp.qcloudmail.com for Guangzhou.
DSH_SMTP_HOST=smtpdm.aliyun.com
DSH_SMTP_PORT=465
DSH_SMTP_SECURITY=tls
DSH_SMTP_USER=noreply@mail.harness.example.com
DSH_SMTP_PASSWORD=
# DSH_SENDMAIL_COMMAND=/usr/sbin/sendmail   (with DSH_MAIL_PROVIDER=sendmail)

# Human verification: aliyun | tencent | turnstile | none (invite-only)
DSH_CAPTCHA_PROVIDER=aliyun
DSH_ALIYUN_CAPTCHA_ACCESS_KEY_ID=
DSH_ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
DSH_ALIYUN_CAPTCHA_SCENE_ID=
DSH_ALIYUN_CAPTCHA_PREFIX=
# DSH_ALIYUN_CAPTCHA_REGION=cn
# DSH_TENCENT_CAPTCHA_SECRET_ID=  DSH_TENCENT_CAPTCHA_SECRET_KEY=  DSH_TENCENT_CAPTCHA_APP_ID=  DSH_TENCENT_CAPTCHA_APP_SECRET_KEY=
# DSH_TURNSTILE_SITE_KEY=  DSH_TURNSTILE_SECRET_KEY=

# Enterprise SSO (on-premises deployments): off | oidc. Unset means off. Uncomment the block to enable OIDC.
# Register the redirect URI <publicOrigin>/api/auth/sso/callback at the IdP (confidential client, Authorization Code + PKCE S256).
# Accounts are created on first sign-in only for members of DSH_SSO_ALLOWED_GROUPS (comma-separated values of the group claims).
# DSH_SSO_PROVIDER=oidc
# DSH_OIDC_ISSUER=https://idp.corp.example/realms/corp
# DSH_OIDC_CLIENT_ID=deepseek-harness
# DSH_OIDC_CLIENT_SECRET=
# DSH_OIDC_SCOPES=openid email profile
# DSH_OIDC_GROUP_CLAIMS=groups
# DSH_SSO_ALLOWED_GROUPS=engineering
# DSH_OIDC_TIMEOUT_MS=5000
# Administrator emergency password: source addresses (IPs or CIDR prefixes) allowed to use /account/emergency. Unset disables it.
# Enroll administrators with dsh-identity-emergency; each needs a TOTP authenticator.
# DSH_SSO_EMERGENCY_ALLOWED_IPS=10.0.0.0/24

# Administrator role: comma-separated addresses that see 系统管理 in Harness Web (emergency accounts are administrators too).
# DSH_ADMIN_EMAILS=it-admin@example.com

# WeCom (企业微信) web login instead of OIDC: DSH_SSO_PROVIDER=wecom. Use a self-built app; set its trusted domain to the public host,
# because WeCom redirects to <publicOrigin>/api/auth/sso/callback. DSH_SSO_ALLOWED_GROUPS then holds department IDs (sub-departments included by default).
# DSH_WECOM_CORP_ID=
# DSH_WECOM_AGENT_ID=
# DSH_WECOM_SECRET=
# DSH_WECOM_DEPARTMENT_RECURSIVE=true
# DSH_WECOM_TIMEOUT_MS=5000
# Private (私有化) WeCom: point both at the intranet server (HTTPS only).
# DSH_WECOM_API_BASE=https://qyapi.weixin.qq.com
# DSH_WECOM_LOGIN_URL=https://login.work.weixin.qq.com/wwlogin/sso/login

# DingTalk (钉钉) web login instead: DSH_SSO_PROVIDER=dingtalk. Use an internal app with member read permission and register
# <publicOrigin>/api/auth/sso/callback as its redirect URL. DSH_SSO_ALLOWED_GROUPS then holds department IDs (sub-departments included by default).
# DSH_DINGTALK_CLIENT_ID=
# DSH_DINGTALK_CLIENT_SECRET=
# DSH_DINGTALK_CORP_ID=
# DSH_DINGTALK_DEPARTMENT_RECURSIVE=true
# DSH_DINGTALK_EXCLUSIVE_LOGIN=false
# DSH_DINGTALK_TIMEOUT_MS=5000
# Private DingTalk: point these at the dedicated hosts (HTTPS only).
# DSH_DINGTALK_LOGIN_URL=https://login.dingtalk.com/oauth2/auth
# DSH_DINGTALK_API_BASE=https://api.dingtalk.com
# DSH_DINGTALK_OAPI_BASE=https://oapi.dingtalk.com

# SAML 2.0 instead: DSH_SSO_PROVIDER=saml. Give the IdP <publicOrigin>/api/auth/sso/metadata (ACS <publicOrigin>/api/auth/sso/acs).
# The certificate file holds only the IdP signing certificate(s) in PEM; it is read at start and never fetched.
# DSH_SAML_SP_ENTITY_ID=https://harness.corp.example/saml
# DSH_SAML_IDP_ENTITY_ID=https://idp.corp.example/saml
# DSH_SAML_IDP_SSO_URL=https://idp.corp.example/saml/sso
# DSH_SAML_IDP_CERT_FILE=/etc/dsh-public/identity-secrets/saml-idp.crt
# DSH_SAML_NAMEID_FORMAT=persistent
# DSH_SAML_GROUP_ATTRIBUTE=groups
# DSH_SAML_EMAIL_ATTRIBUTE=email
# DSH_SAML_NAME_ATTRIBUTE=displayName
# DSH_SAML_WANT_ASSERTIONS_SIGNED=false
# DSH_SAML_CLOCK_SKEW_MS=60000
# When the IdP requires signed AuthnRequests. Key files: owned by dsh-identity, chmod 600, no symlink; RSA 2048+ matching the certificate.
# DSH_SAML_SIGN_REQUESTS=true
# DSH_SAML_SP_SIGNING_KEY_FILE=/etc/dsh-public/identity-secrets/saml-sp-signing.key
# DSH_SAML_SP_SIGNING_CERT_FILE=/etc/dsh-public/identity-secrets/saml-sp-signing.crt
# When the IdP encrypts assertions (the decryption key is read from a file only; plain assertions are then refused).
# DSH_SAML_ENCRYPTED_ASSERTIONS=true
# DSH_SAML_SP_DECRYPTION_KEY_FILE=/etc/dsh-public/identity-secrets/saml-sp-encryption.key
# DSH_SAML_SP_DECRYPTION_CERT_FILE=/etc/dsh-public/identity-secrets/saml-sp-encryption.crt

# LDAP / Active Directory instead: DSH_SSO_PROVIDER=ldap. Users sign in with a form; the service account searches, then binds as the user.
# ldaps://, or ldap:// with DSH_LDAP_STARTTLS=true. The CA file holds only PEM certificates. Allowed groups are DNs separated by ';'.
# DSH_LDAP_URL=ldaps://dc1.corp.example:636
# DSH_LDAP_STARTTLS=false
# DSH_LDAP_CA_FILE=/etc/dsh-public/identity-secrets/ldap-ca.crt
# DSH_LDAP_BIND_DN=CN=svc-harness,OU=Service Accounts,DC=corp,DC=example
# DSH_LDAP_BIND_PASSWORD=
# DSH_LDAP_BASE_DN=DC=corp,DC=example
# DSH_LDAP_SCHEMA=ad
# DSH_LDAP_GROUP_MODE=nested
# DSH_LDAP_TIMEOUT_MS=5000

# Quota account socket opened by dsh-quota (its "accountSocket", with "accountSocketGid" set to the dsh-identity group).
# It feeds personal usage in the personal center and the allowance editor in system administration; unset turns both off.
DSH_QUOTA_ACCOUNT_SOCKET=/run/dsh-public/quota-account/account.sock

# Automatic deprovisioning (any SSO provider). Directory lookups for LDAP/AD, WeCom and DingTalk; errors never disable anyone.
# 0 turns the scheduler off. Inactivity is off unless set. Runs that would disable more users than the cap disable none.
# DSH_SSO_RECONCILE_INTERVAL_MINUTES=60
# DSH_SSO_MAX_INACTIVE_DAYS=90
# DSH_SSO_RECONCILE_MAX_DISABLE=10
