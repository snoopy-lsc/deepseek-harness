[Unit]
Description=Native public Harness knowledge base root helper (one request: start the user helper as the tree's owner)
CollectMode=inactive-or-failed

[Service]
Type=simple
User=root
ExecStart=/usr/bin/node /opt/dsh-public/integration/packages/production/lib/kb-root-helper.js /etc/dsh-public/kb-root.json
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Its only job is `systemd-run --uid=<account>` for one validated request: a fixed verb set, whitelisted arguments, the account
# re-derived from the user ID, and the canonical, link-free <storageRoot>/users/<account>/kb. It reads no tenant file and writes nothing.
# CAP_SYS_ADMIN is the one capability PID 1 checks before it starts a transient unit for a D-Bus caller; mounts stay filtered below.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @raw-io @reboot @swap @clock @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/etc/dsh-public /opt/dsh-public
InaccessiblePaths=-/var/lib/dsh-public/kb -/etc/dsh-public/secrets -/etc/dsh-public/identity-secrets -/var/lib/dsh-public/state -/var/lib/dsh-public/profiles
MemoryMax=1536M
TasksMax=32
RuntimeMaxSec=900
