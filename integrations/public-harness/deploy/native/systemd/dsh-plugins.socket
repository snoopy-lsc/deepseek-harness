[Unit]
Description=Team Harness plugin market ports (installer expands ListenStream from ports.market)
PartOf=dsh-public.target
# A host ruleset reload (nftables.service runs `flush ruleset`) drops inet dsh_market;
# PartOf restarts this socket so the loader below runs again.
After=nftables.service
PartOf=nftables.service
Before=dsh-provisioner.service
# Holds the whole ports.market range so no other process can bind a market port.

[Socket]
# Sketch: one example ListenStream. The installer writes the real unit with
# render-market-firewall.ts, one ListenStream=127.0.0.1:<port> line per port in ports.market.
ListenStream=127.0.0.1:30000
Service=dsh-plugins.service
RemoveOnStop=yes
# Fatal loader for inet dsh_market (priority filter - 2, per-owner uid . port set).
# No "-" prefix: if the table cannot be loaded this socket unit fails and every market
# listener closes, instead of leaving the ports reachable by every instance account.
ExecStartPost=/usr/lib/dsh-public/load-dsh-market.sh /etc/dsh-public/dsh-market.nft
# The loader's private copy lives in this unit's own /tmp, removed by systemd even if the loader is killed.
PrivateTmp=yes

[Install]
WantedBy=sockets.target
