[Unit]
Description=Team Harness plugin market egress CONNECT proxy
PartOf=dsh-public.target
After=network-online.target
Before=dsh-plugins.service

[Service]
Type=simple
User=dsh-plugins-egress
Group=dsh-plugins-egress
Environment=DSH_HOME=/var/lib/dsh-public/plugins-egress-home
ExecStart=/usr/bin/node /opt/dsh-public/harness/apps/cli/lib/bin.js --profile plugins-egress
Restart=on-failure
RestartSec=3
# Outbound network allowed; no durable state; empty capabilities. Fetch UID reachability is nft (1B).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Sketch only: profile wiring and sysusers land with 1B install.

[Install]
WantedBy=dsh-public.target
