# Public Harness edge. Caddy terminates TLS, authenticates EVERY request and WebSocket handshake with the
# authentik proxy outpost, replaces all client-supplied identity headers, and forwards only to the team
# router's permission-restricted Unix socket. Environment values are set in the systemd unit, never here.
#   DSH_PUBLIC_HOST      public host name, e.g. harness.example.com
#   DSH_ACME_EMAIL       contact for the certificate authority
#   DSH_OUTPOST_ADDR     authentik proxy outpost, loopback only, e.g. 127.0.0.1:9000
#   DSH_ROUTER_SOCKET    e.g. /run/dsh-public/router/router.sock
{
	email {$DSH_ACME_EMAIL}
	# Caddy must not trust forwarded headers from any client: it is the first hop.
	servers {
		trusted_proxies static
		timeouts {
			read_header 10s
			idle 120s
		}
	}
}

{$DSH_PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Authentik's own pages (login, enrollment, email verification, CAPTCHA) are served by the outpost.
	handle /outpost.goauthentik.io/* {
		reverse_proxy {$DSH_OUTPOST_ADDR}
	}

	handle {
		# `route` keeps this order: strip first, authenticate second, forward third.
		route {
			request_header -X-Authentik-Uid
			request_header -X-Authentik-Jwt
			request_header -X-Authentik-Username
			request_header -X-Authentik-Email
			request_header -X-Authentik-Groups
			request_header -X-Authentik-Name
			request_header -X-Authentik-Meta-*
			request_header -X-Forwarded-User
			request_header -X-Real-Ip
			request_header -Forwarded
			request_header -X-Original-Url
			request_header -X-Original-Uri

			forward_auth {$DSH_OUTPOST_ADDR} {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Uid X-Authentik-Jwt
			}

			# A WebSocket upgrade passes through this same chain, so it is authenticated at the handshake;
			# the router closes the connection after at most 60 seconds, forcing re-authentication.
			reverse_proxy unix/{$DSH_ROUTER_SOCKET} {
				header_up Host {host}
				flush_interval -1
				transport http {
					response_header_timeout 120s
				}
			}
		}
	}

	log {
		# Access logs carry no query strings, cookies, or identity headers.
		output file /var/log/caddy/dsh-public-access.log
		format filter {
			wrap json
			request>uri delete
			request>headers delete
			resp_headers>Set-Cookie delete
		}
	}
}
