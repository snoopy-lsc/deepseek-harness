# Instance image: one `dsh --profile web` per container, started by container-entry.js from the read-only assets mount.
# Build with: scripts/build-image.sh <dsh.tgz> <image-ref>, which installs the packed Harness CLI you pass in
# (DSH_TARBALL). Neither build-image.sh nor build-assets.sh reads production/release-manifest.json: pack the
# version that manifest pins, and record the built reference in its runtime.image yourself.
# The base digest is still a placeholder and the build fails until it is pinned: replace REPLACE_WITH_PINNED_DIGEST
# with the digest of the exact node image before cutting a frozen-line release.
FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:REPLACE_WITH_PINNED_DIGEST

ARG DSH_TARBALL
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*

# The Harness CLI and the plugin dependencies the bundles import live under /opt/dsh; assets are mounted read-only
# at /opt/public-harness and reach these packages through its `node_modules` symlink.
COPY ${DSH_TARBALL} /tmp/dsh.tgz
RUN mkdir -p /opt/dsh && cd /opt/dsh && npm install --omit=dev --ignore-scripts --no-audit /tmp/dsh.tgz \
 && ln -s /opt/dsh/node_modules/.bin/dsh /usr/local/bin/dsh && rm /tmp/dsh.tgz

# Unprivileged, no secrets, no model key. The runtime maps the host account onto this user.
RUN useradd --uid 10001 --create-home --home-dir /home/harness --shell /bin/bash harness
USER 10001:10001
WORKDIR /workspace
ENV HOME=/home/harness DSH_TELEMETRY_DISABLED=1
ENTRYPOINT ["node", "/opt/public-harness/container-entry.js"]
