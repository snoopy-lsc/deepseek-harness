{
  "name": "@public-harness/plugins",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/plugins/tests"
  },
  "dependencies": {
    "@public-harness/plugin-sync": "workspace:*"
  }
}
